# Copy to .env and fill in real values. Never commit the real .env file.
#
# Every variable below is read somewhere in config/settings/*.py — none
# are aspirational. (An earlier version of this file documented
# DATABASE_URL as if it did something while no settings file actually
# read it; that's been fixed — see PRODUCTION_DEPLOYMENT.md "Environment
# variables audit" if you're curious about the history.)
#
# TROUBLESHOOTING "sqlite3.OperationalError: unable to open database
# file" on a local machine (most common on Windows): it means Django
# loaded config.settings.production instead of config.settings.development
# — production.py resolves its SQLite path from DJANGO_DB_PATH, which
# defaults to an absolute PythonAnywhere path that doesn't exist on your
# machine. Fix: check DJANGO_SETTINGS_MODULE in your own .env (not this
# example file) and make sure it reads exactly
# "config.settings.development" for local work, and leave DJANGO_DB_PATH
# further below commented out unless you are actually deploying.

# =====================================================================
# LOCAL DEVELOPMENT — this is what a fresh `cp .env.example .env` gives
# you. Nothing in this block should ever need a real machine-specific
# path, a PythonAnywhere username, or a production secret.
# =====================================================================
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost

# Parsed by django-environ's env.db(). Leave commented out to fall back
# to a local SQLite file living inside the project folder itself —
# config/settings/development.py's own default, which works identically
# on Windows, macOS, and Linux with zero configuration. Uncomment only
# to point at a different database entirely, including the eventual
# move to Postgres:
#   DATABASE_URL=postgres://user:password@host:5432/sams
#
# Important: leave this line commented out, not set to an empty value —
# django-environ's env.db(default=...) only falls back to its default
# when the variable is entirely absent from the environment. A present-
# but-empty DATABASE_URL= is parsed as an (invalid) URL instead of
# triggering the default, which breaks startup entirely. Caught and
# fixed during this project's own production audit — see
# PRODUCTION_DEPLOYMENT.md "Environment variables audit".
# DATABASE_URL=

# Slug of the Association this deployment serves (core/models.py).
DEFAULT_ASSOCIATION_SLUG=msa

# =====================================================================
# PYTHONANYWHERE PRODUCTION ONLY — everything below this line is for
# the real deployment. Do not uncomment these on a local machine: doing
# so is exactly what causes DJANGO_SETTINGS_MODULE/DJANGO_DB_PATH mixups
# like the one described in the troubleshooting note above. See
# PRODUCTION_DEPLOYMENT.md for the full deploy checklist.
# =====================================================================

# On PythonAnywhere's own Bash console / WSGI config, set (don't just
# leave commented):
#   DJANGO_SETTINGS_MODULE=config.settings.production
#   DEBUG=False
# DJANGO_SETTINGS_MODULE=config.settings.production
# DEBUG=False

# Required — production.py has no insecure fallback; a missing
# SECRET_KEY fails loudly at startup on purpose. Generate a fresh long
# random string for the real deployment; never reuse the local dev one
# above.
# SECRET_KEY=generate-a-new-long-random-string-for-production

# SQLite-specific convenience alternative to DATABASE_URL — easier to
# point at a specific absolute path on PythonAnywhere than to build a
# sqlite:/// URL by hand. Ignored if DATABASE_URL is also set. Left
# commented out here on purpose: uncommented, this literal example path
# is a real Unix path with a placeholder username, which will fail with
# "unable to open database file" on both a fresh PythonAnywhere account
# (wrong username) and any local machine (path doesn't exist at all,
# and is Windows-incompatible besides). Fill in with your own
# PythonAnywhere username and project path when you actually deploy:
# DJANGO_DB_PATH=/home/yourusername/student-association-management-system/db.sqlite3

# Must include the scheme. CRITICAL on PythonAnywhere — without this,
# every POST request (registration, voting, the contact form, admin
# logins) fails CSRF validation. See PRODUCTION_DEPLOYMENT.md "Reverse
# proxy / HTTPS". Replace with your own PythonAnywhere domain.
# CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com

# Set to False only temporarily while first verifying a deploy without
# HTTPS configured yet; must be True (production.py's own default) for
# real traffic.
# SECURE_SSL_REDIRECT=True

# name:email pairs, comma-separated. Unhandled view exceptions are
# emailed here (see LOGGING in production.py). Leave unset and server
# errors fail silently from your perspective — you'd only find out from
# a user reporting it.
# DJANGO_ADMINS=Admin Name:admin@example.com

# SMTP — kept only for Django's own DJANGO_ADMINS error-notification
# emails (mail_admins). Member-facing email (approval emails, Communication
# Center announcements) uses the Mailjet section below instead, over
# HTTPS, specifically because PythonAnywhere Free blocks outbound SMTP.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# =====================================================================
# MAILJET EMAIL API — used in every environment, not just production.
# =====================================================================
# Used by apps.core.mailjet_service for member-facing email: approval
# emails (apps/members/email_service.py) and Communication Center
# announcements (apps/accounts/notifications.py). Talks to Mailjet over
# HTTPS (the Send API), never SMTP — see that module's docstring.
#
# Leave MAILJET_API_KEY / MAILJET_SECRET_KEY unset for local development:
# apps.core.mailjet_service then logs the email it would have sent
# instead of making a real API call, so a fresh clone works without a
# Mailjet account. Both are required for real delivery in production.
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key

# Sender identity for Mailjet-delivered mail. DEFAULT_FROM_EMAIL must be
# an address verified in the Mailjet account (Mailjet rejects unverified
# senders — this project does not and cannot bypass that verification).
DEFAULT_FROM_EMAIL=your_verified_sender@example.com
DEFAULT_FROM_NAME=SAMS
